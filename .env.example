# PhishExplain — environment variables (set in Vercel → Project → Settings → Environment Variables).
# Never commit real values. Every variable is optional: with none set, the local scanner works fully
# and the server features report themselves as "unavailable".

# ── Shield access control ───────────────────────────────────────────────
# Shared access key required for reputation lookups and AI analysis (min 16 chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SHIELD_ACCESS_KEY=

# ── URL reputation providers (any subset) ───────────────────────────────
# Google Safe Browsing v5 — NON-COMMERCIAL use only (use Google Web Risk for commercial products).
GOOGLE_SAFE_BROWSING_API_KEY=
# URLhaus (abuse.ch) — free Auth-Key from https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# VirusTotal API v3 — lookup only (Shield never submits URLs). Public API: non-commercial, 4 req/min, 500/day.
VIRUSTOTAL_API_KEY=
# Global daily cap on reputation requests (protects provider quotas). Default 300.
SHIELD_REPUTATION_DAILY_LIMIT=300
# Set to "true" to allow reputation lookups WITHOUT the access key. Only honored when a durable
# rate limiter (below) is configured.
SHIELD_REPUTATION_PUBLIC=false

# ── AI contextual analysis (OpenAI) ─────────────────────────────────────
OPENAI_API_KEY=
# Model for Shield AI analysis (falls back to OPENAI_MODEL, then gpt-4.1-mini).
SHIELD_AI_MODEL=
SHIELD_AI_HOURLY_LIMIT=30
SHIELD_AI_DAILY_LIMIT=100

# ── Durable rate limiting (Upstash Redis REST or Vercel KV) ─────────────
# Without these, limits are per serverless instance (best effort) and public reputation stays disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV integrations may instead provide KV_REST_API_URL / KV_REST_API_TOKEN — both are accepted.)

# ── CAP 6640 research lab (unchanged) ───────────────────────────────────
OPENAI_MODEL=gpt-4.1-mini
PHISHEXPLAIN_RESEARCH_KEY=
